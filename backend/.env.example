# Local development only. Copy to .env and run "php artisan key:generate" inside the app container.
# docker-compose.yml sets the DB_* and MAIL_* values, and those win over this file.
# Production settings live in protected configuration on the server, never in git.

APP_NAME="Natatorio Gym"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Proxies in front of nginx that pass on the client IP, comma separated. Empty: no proxy in front.
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Disposable browser-test account for development and CI. Never use in production.
E2E_USER_EMAIL=user@example.com
E2E_USER_PASSWORD=test-user-password-129

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=natatorio_gym
DB_USERNAME=natatorio
DB_PASSWORD=local-only-change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WooCommerce store (read-only REST API key). Never commit real values.
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Check In boundary (REQ-NF-28, REQ-NF-29). Empty center uses the gym coordinates. The app refuses to start
# when the center distance plus the radius is over 50 m, unless CHECK_IN_ALLOW_ANY_BOUNDARY=true (development and the demo only).
CHECK_IN_CENTER_LATITUDE=
CHECK_IN_CENTER_LONGITUDE=
CHECK_IN_RADIUS_METERS=50
CHECK_IN_MAX_ACCURACY_METERS=50
CHECK_IN_NOTICE_MINUTES=60
CHECK_IN_ALLOW_ANY_BOUNDARY=false
