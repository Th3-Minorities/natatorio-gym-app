stateDiagram-v2
  direction LR
  state "Account exists" as Account {
    [*] --> Active : paid order claimed at registration,<br/>or athlete registration link used
    Active --> Revoked : athlete withdrawn<br/>from the roster
    Revoked --> Active : athlete reinstated<br/>with a written reason
    Active --> TermOver : academic term ends
  }
  Account --> [*] : account deleted<br/>(from any state)

  state "Current<br/>Check In and Gym ID allowed" as Active
  state "Revoked (athletes only)<br/>Check In refused" as Revoked
  state "Expired<br/>term ended" as TermOver

  note right of Active
    Check In also needs a current photo;<br/>Staff can ask for a new one
  end note
